# CME Control Motion Electronics – Production Dockerfile for Mittwald
# Single-stage build for reliability

FROM node:22-alpine

WORKDIR /app

# Enable corepack (pnpm version is controlled by packageManager field in package.json)
RUN corepack enable

# Copy package files AND patches (needed by pnpm install for patchedDependencies)
COPY package.json pnpm-lock.yaml ./
COPY patches/ ./patches/

# Install all dependencies
RUN pnpm install

# Copy source code
COPY . .

# Build the application (Vite frontend + esbuild server + SEO pages)
RUN pnpm build

# Assets vorkomprimieren (Brotli + gzip).
# Express komprimiert nicht von sich aus; ohne diesen Schritt gehen die
# Bundles roh ueber die Leitung – gemessen 739 KB statt 154 KB.
# server/precompressedAssets.ts liefert die Varianten dann aus.
# Bewusst hier und nicht im package.json-Build: ausgeliefert wird nur das
# Image, und der lokale Entwicklungsbuild bleibt schnell.
RUN node scripts/precompress-assets.mjs

# Expose port 3000
EXPOSE 3000

# Set production environment
ENV NODE_ENV=production
ENV PORT=3000

# Start the server
CMD ["node", "dist/index.js"]
